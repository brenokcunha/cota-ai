# Fonte de dados de estabelecimentos. Hoje so `scraper` esta implementado;
# `places-api` e `own-db` sao reservados e falham ao buscar.
PLACES_PROVIDER=scraper

# Postgres — cache de buscas, base de estabelecimentos e cotacoes salvas.
# No docker compose isso ja vem preenchido. Fora dele, aponte para o banco:
#   postgres://cotaai:cotaai@localhost:55432/cotaai
# Sem a variavel o app roda mesmo assim: busca ao vivo, sem cache e sem link
# de retomada.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Dias que um resultado de busca vale antes de nova coleta
SEARCH_CACHE_TTL_DAYS=7

# --- Scraper (PLACES_PROVIDER=scraper) ---------------------------------------
# Todos opcionais. Os defaults são conservadores de proposito: scraper
# apressado toma bloqueio de IP, que e o risco #1 do projeto.

# false abre o browser com janela — util so fora do Docker
SCRAPER_HEADLESS=true
# Pausa entre visitas a fichas, em ms. E o rate limiting da coleta.
SCRAPER_DELAY_MS=1200
# Timeout de cada navegacao/espera, em ms
SCRAPER_TIMEOUT_MS=30000
# Valvula de seguranca: teto absoluto por busca. Baixar isso abaixo do que a
# tela oferece faz o servidor devolver menos do que foi pedido, calado.
SCRAPER_MAX_RESULTS=60
# Idioma e fuso do browser do scraper. Mudar so se o Maps passar a responder
# em outro idioma; os seletores e o parse assumem pt-BR.
SCRAPER_LOCALE=pt-BR
SCRAPER_TIMEZONE=America/Sao_Paulo
# Proxy de saida (http://user:senha@host:porta)
SCRAPER_PROXY_URL=
# Pasta onde salvar screenshot + HTML quando uma ficha falha
SCRAPER_DEBUG_DIR=

# --- Geocodificacao (mapa acompanhar a regiao digitada) ----------------------
# Por padrao usa o Nominatim publico do OpenStreetMap, que limita a 1 req/s.
# Suficiente para uso pessoal; aponte para outra instancia se precisar de mais.
NOMINATIM_URL=
# A politica do Nominatim exige um User-Agent que identifique a aplicacao.
NOMINATIM_USER_AGENT=
